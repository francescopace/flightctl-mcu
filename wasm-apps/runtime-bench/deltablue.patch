+__attribute__((import_module("env"), import_name("clock_ms"))) int clock_ms(void);
+__attribute__((export_name("run"))) int run(void) {
+    int elapsed[3];
+    for (int group = 0; group < 3; group++) {
+        int start = clock_ms();
+        for (int iteration = 0; iteration < 10; iteration++) {
+            for (int pair = 0; pair < 10; pair++) {
+                /* 51 variables make 50 equality constraints. */
+                ChainTest(51);
+                ProjectionTest(50);
+            }
+        }
+        elapsed[group] = clock_ms() - start;
+        printf("BENCH deltablue group %d total_ms %d\n", group, elapsed[group]);
+    }
+    int a = elapsed[0], b = elapsed[1], c = elapsed[2];
+    if (a > b) {
+        if (a < c) return a;
+        return b > c ? b : c;
+    }
+    if (b < c) return b;
+    return a > c ? a : c;
+}
