/* The board map's names on native_sim's emulated drivers. */
/ {
	fc-hw {
		compatible = "flightctl,app-hw";
		relay1 {
			gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
			safe = <0>;
		};
		button0 {
			gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
		};
		level {
			io-channels = <&adc0 0>;
		};
		fan {
			pwms = <&pwm0 0 1000000>;
		};
		sensors {
			i2c-bus = <&i2c0>;
			clock-frequency = <100000>; /* the AT24 emulator refuses faster buses */
		};
		flash {
			spi-bus = <&spi0>;
			cs-gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
			spi-mode = <3>;
		};
		other {
			spi-bus = <&spi0>;
			cs-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
		};
		serial {
			uart = <&euart0>;
			current-speed = <9600>;
		};
		rs485 {
			uart = <&euart1>;
			de-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		};
		console {
			uart = <&uart0>;
		};
	};

	pwm0: pwm {
		compatible = "zephyr,fake-pwm";
		#pwm-cells = <2>;
		frequency = <1000000>;
	};

	euart0: uart-emul0 {
		compatible = "zephyr,uart-emul";
		current-speed = <115200>;
		loopback;
	};

	euart1: uart-emul1 {
		compatible = "zephyr,uart-emul";
		current-speed = <115200>;
	};
};

&adc0 {
	ref-internal-mv = <3300>;
	#address-cells = <1>;
	#size-cells = <0>;
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&i2c0 {
	eeprom: eeprom@50 {
		compatible = "atmel,at24";
		reg = <0x50>;
		size = <256>;
		pagesize = <8>;
		address-width = <8>;
		timeout = <5>;
	};
};

&spi0 {
	loopback: loopback@0 {
		compatible = "flightctl,test-spi-loopback";
		reg = <0>;
		spi-max-frequency = <50000000>;
	};
};
