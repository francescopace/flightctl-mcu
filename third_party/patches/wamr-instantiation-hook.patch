+static wasm_instantiation_hook_t instantiation_hook;
+
+void
+wasm_runtime_set_instantiation_hook(wasm_instantiation_hook_t hook)
+{
+    instantiation_hook = hook;
+}
+
+void
+wasm_runtime_call_instantiation_hook(WASMExecEnv *exec_env, bool begin)
+{
+    if (instantiation_hook)
+        instantiation_hook(exec_env, begin);
+}
