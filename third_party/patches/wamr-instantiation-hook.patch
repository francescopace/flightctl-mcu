+/**
+ * Called on the thread that instantiates a module, around the code the
+ * module runs as it is instantiated (its start function, __post_instantiate,
+ * __wasm_call_ctors), with the exec env that code runs in: begin is true
+ * before it runs and false after. The embedder can give that exec env its
+ * user data and an instruction count limit, as for a call of its own.
+ *
+ * @param hook the function, NULL for none
+ */
+typedef void (*wasm_instantiation_hook_t)(wasm_exec_env_t exec_env,
+                                          bool begin);
+
+WASM_RUNTIME_API_EXTERN void
+wasm_runtime_set_instantiation_hook(wasm_instantiation_hook_t hook);
+
