                         CHECK_SUSPEND_FLAGS();
 #endif
                         castflags = *frame_ip++;
@@ -5551,7 +5561,7 @@ wasm_interp_call_func_bytecode(WASMModuleInstance *module,
                         if (ret == (uint32)-1)
                             goto got_exception;
 
-#if WASM_ENABLE_THREAD_MGR != 0
+#if WASM_ENABLE_THREAD_MGR != 0 || WASM_ENABLE_INSTRUCTION_METERING != 0
                         CHECK_SUSPEND_FLAGS();
 #endif
 
@@ -5575,7 +5585,7 @@ wasm_interp_call_func_bytecode(WASMModuleInstance *module,
                         if (ret == (uint32)-1)
                             goto got_exception;
 
-#if WASM_ENABLE_THREAD_MGR != 0
+#if WASM_ENABLE_THREAD_MGR != 0 || WASM_ENABLE_INSTRUCTION_METERING != 0
