             wasm_exec_env_set_cur_frame(exec_env, (WASMRuntimeFrame *)frame);
         }
-#if WASM_ENABLE_THREAD_MGR != 0
+#if WASM_ENABLE_THREAD_MGR != 0 || WASM_ENABLE_INSTRUCTION_METERING != 0
         CHECK_SUSPEND_FLAGS();
 #endif
         HANDLE_OP_END();
