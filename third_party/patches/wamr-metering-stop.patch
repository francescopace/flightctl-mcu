 #endif
                 count = read_uint32(frame_ip);
@@ -1759,7 +1769,7 @@ wasm_interp_call_func_bytecode(WASMModuleInstance *module,
 #if WASM_ENABLE_TAIL_CALL != 0
                 GET_OPCODE();
 #endif
-#if WASM_ENABLE_THREAD_MGR != 0
+#if WASM_ENABLE_THREAD_MGR != 0 || WASM_ENABLE_INSTRUCTION_METERING != 0
                 CHECK_SUSPEND_FLAGS();
 #endif
 
@@ -2041,7 +2051,7 @@ wasm_interp_call_func_bytecode(WASMModuleInstance *module,
 #if WASM_ENABLE_GC != 0
             HANDLE_OP(WASM_OP_CALL_REF)
             {
-#if WASM_ENABLE_THREAD_MGR != 0
+#if WASM_ENABLE_THREAD_MGR != 0 || WASM_ENABLE_INSTRUCTION_METERING != 0
                 CHECK_SUSPEND_FLAGS();
 #endif
                 func_obj = POP_REF();
@@ -2056,7 +2066,7 @@ wasm_interp_call_func_bytecode(WASMModuleInstance *module,
             }
             HANDLE_OP(WASM_OP_RETURN_CALL_REF)
             {
-#if WASM_ENABLE_THREAD_MGR != 0
+#if WASM_ENABLE_THREAD_MGR != 0 || WASM_ENABLE_INSTRUCTION_METERING != 0
                 CHECK_SUSPEND_FLAGS();
 #endif
                 func_obj = POP_REF();
@@ -2090,7 +2100,7 @@ wasm_interp_call_func_bytecode(WASMModuleInstance *module,
             }
             HANDLE_OP(WASM_OP_BR_ON_NULL)
             {
-#if WASM_ENABLE_THREAD_MGR != 0
+#if WASM_ENABLE_THREAD_MGR != 0 || WASM_ENABLE_INSTRUCTION_METERING != 0
                 CHECK_SUSPEND_FLAGS();
 #endif
                 opnd_off = GET_OFFSET();
@@ -2106,7 +2116,7 @@ wasm_interp_call_func_bytecode(WASMModuleInstance *module,
             }
             HANDLE_OP(WASM_OP_BR_ON_NON_NULL)
             {
-#if WASM_ENABLE_THREAD_MGR != 0
+#if WASM_ENABLE_THREAD_MGR != 0 || WASM_ENABLE_INSTRUCTION_METERING != 0
                 CHECK_SUSPEND_FLAGS();
 #endif
                 opnd_off = GET_OFFSET();
