         /* TODO: support suspend and breakpoint */          \
         WASM_SUSPEND_FLAGS_UNLOCK(exec_env->wait_lock);     \
     } while (0)
+#elif WASM_ENABLE_INSTRUCTION_METERING != 0
+/* Another thread stops a running call by setting the exec env's instruction
+ * limit to 0 (wasm_runtime_set_instruction_count_limit): checked at branches
+ * and calls, so the next instruction traps with "instruction limit exceeded".
+ * The count itself stays in a local, as upstream. */
+#define CHECK_SUSPEND_FLAGS()                                         \
+    do {                                                              \
+        if (*(volatile int *)&exec_env->instructions_to_execute == 0) \
+            instructions_left = 0;                                    \
+    } while (0)
 #endif
 
 #if WASM_ENABLE_OPCODE_COUNTER != 0
