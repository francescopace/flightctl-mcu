                 CHECK_SUSPEND_FLAGS();
 #endif
             recover_br_info:
@@ -1649,7 +1659,7 @@ wasm_interp_call_func_bytecode(WASMModuleInstance *module,
 
             HANDLE_OP(WASM_OP_BR_IF)
             {
-#if WASM_ENABLE_THREAD_MGR != 0
