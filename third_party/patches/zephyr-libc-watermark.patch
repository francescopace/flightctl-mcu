+/* Called under the common libc allocator lock, after each allocation. */
+#ifdef CONFIG_FC_LIBC_HEAP_WATERMARK
+Z_LIBC_DATA static size_t min_free_bytes = SIZE_MAX;
+
+static void record_free_bytes(void)
+{
+	struct sys_memory_stats stats;
+	if (sys_heap_runtime_stats_get(&z_malloc_heap, &stats) == 0) {
+		min_free_bytes = MIN(min_free_bytes, stats.free_bytes);
+	}
+}
+
+void fc_common_libc_heap_stats(size_t *total, size_t *free_now, size_t *low);
+void fc_common_libc_heap_stats(size_t *total, size_t *free_now, size_t *low)
+{
+	struct sys_memory_stats stats = {0};
+	malloc_lock();
+	if (z_malloc_heap.heap != NULL) {
+		sys_heap_runtime_stats_get(&z_malloc_heap, &stats);
+	}
+	*total = stats.free_bytes + stats.allocated_bytes;
+	*free_now = stats.free_bytes;
+	*low = min_free_bytes == SIZE_MAX ? 0 : min_free_bytes;
+	malloc_unlock();
+}
+#else
+#define record_free_bytes() do { } while (0)
+#endif
