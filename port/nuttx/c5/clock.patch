--- a/arch/risc-v/src/common/espressif/Kconfig
+++ b/arch/risc-v/src/common/espressif/Kconfig
@@ -201,6 +201,13 @@
 	---help---
 		Set the CPU frequency to 160 MHz.
 
+config ESPRESSIF_CPU_FREQ_240
+	bool "240 MHz"
+	depends on ARCH_CHIP_ESP32C5
+	select ESP_DEFAULT_CPU_FREQ_MHZ_240
+	---help---
+		Run the CPU from the C5 240 MHz PLL.
+
 config ESPRESSIF_CPU_FREQ_360
 	bool "360 MHz"
 	depends on ARCH_CHIP_ESP32P4 && ESP32P4_SELECTS_REV_LESS_V3
@@ -214,6 +221,11 @@
 		Set the CPU frequency to 400 MHz.
 
 endchoice # ESPRESSIF_CPU_FREQ
+
+# The Espressif HAL also uses this setting for PLL selection on early C5 silicon.
+
+config ESP_DEFAULT_CPU_FREQ_MHZ_240
+	bool
 
 config ESPRESSIF_CPU_FREQ_MHZ
 	int
@@ -223,6 +235,7 @@
 	default 80 if ESPRESSIF_CPU_FREQ_80
 	default 96 if ESPRESSIF_CPU_FREQ_96
 	default 160 if ESPRESSIF_CPU_FREQ_160
+	default 240 if ESPRESSIF_CPU_FREQ_240
 	default 360 if ESPRESSIF_CPU_FREQ_360
 	default 400 if ESPRESSIF_CPU_FREQ_400
 
