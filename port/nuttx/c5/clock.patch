                      (CONFIG_BOARD_LOOPSPERMSEC / 1000),
                      (CONFIG_BOARD_LOOPSPERMSEC / 10) % 100);
       procfs_sprintf(buf, buf_size, &file_off, "cpu MHz\t\t: %u.%03u\n",
