CONFIG_INIT_ENTRYPOINT="flightctl_main"
CONFIG_INIT_STACKSIZE=18432
CONFIG_BUILTIN=y
CONFIG_FLIGHTCTL_NRF7002DK=y
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_NRF53_FLASH_PREFETCH=y
CONFIG_NRF53_PROGMEM=y
CONFIG_MTD_PROGMEM=y
CONFIG_NRF53_NET_GPIO_ALLOW_ALL=n
CONFIG_NRF53_NET_POWER_ON_BOOT=y
CONFIG_FLIGHTCTL_SERIAL_NETWORK=y
CONFIG_NET=y
CONFIG_NET_IPv4=y
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NET_SLIP=y
CONFIG_NET_SLIP_PKTSIZE=1500
# Reserve a full MTU for RX while the two management streams use TCP.
CONFIG_IOB_NBUFFERS=64
CONFIG_IOB_THROTTLE=8
CONFIG_NETDB_DNSCLIENT=y
CONFIG_NETDEV_LATEINIT=y
CONFIG_SCHED_LPWORK=y
CONFIG_SCHED_HPWORK=y
CONFIG_DEV_RPMSG=y
CONFIG_RPMSG_UART=n
CONFIG_RPMSG_PING=n
CONFIG_NO_SERIAL_CONSOLE=y
CONFIG_UART0_SERIAL_CONSOLE=n
CONFIG_UART0_BAUD=460800
CONFIG_UART0_RXBUFSIZE=4096
CONFIG_UART0_TXBUFSIZE=2048
CONFIG_STANDARD_SERIAL=y
CONFIG_SERIAL_TERMIOS=y
CONFIG_NRF53_SPI4_MASTER=y
CONFIG_SPI=y
CONFIG_MTD=y
CONFIG_MTD_MX25L=y
CONFIG_MTD_PARTITION=y
CONFIG_FS_LITTLEFS=y
CONFIG_FS_LITTLEFS_PROGRAM_SIZE_FACTOR=1
CONFIG_FS_LITTLEFS_READ_SIZE_FACTOR=1
CONFIG_FS_LITTLEFS_CACHE_SIZE_FACTOR=1
CONFIG_NETUTILS_DHCPC=n
CONFIG_RAW_BINARY=y
CONFIG_DEBUG_FULLOPT=y
CONFIG_LIBM=y
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_BOARDCTL_RESET=n
CONFIG_MX25L_SPIFREQUENCY=8000000
CONFIG_DEV_RANDOM=n
CONFIG_ARCH_BOARD_COMMON=y
