CONFIG_ESPRESSIF_USBSERIAL=y
CONFIG_OTHER_SERIAL_CONSOLE=y
# CONFIG_UART0_SERIAL_CONSOLE is not set
CONFIG_ESPRESSIF_SPIFLASH_LITTLEFS=y
# CONFIG_ESPRESSIF_SPIFLASH_SPIFFS is not set
CONFIG_ESPRESSIF_STORAGE_MTD_OFFSET=0x300000
CONFIG_ESPRESSIF_STORAGE_MTD_SIZE=0x100000
CONFIG_ESPRESSIF_TEMP=y
CONFIG_ESPRESSIF_TEMP_PATH="/dev/temp"
CONFIG_ETC_ROMFS=y
CONFIG_FS_ROMFS=y
CONFIG_ESPRESSIF_SIMPLE_BOOT=y
