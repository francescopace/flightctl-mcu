CONFIG_INIT_ENTRYPOINT="flightctl_main"
CONFIG_INIT_STACKSIZE=18432
CONFIG_BUILTIN=y
CONFIG_FLIGHTCTL_SERIAL_NETWORK=y
CONFIG_NET=y
CONFIG_NET_IPv4=y
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NET_SLIP=y
CONFIG_NET_SLIP_PKTSIZE=1500
CONFIG_IOB_NBUFFERS=64
CONFIG_IOB_THROTTLE=8
CONFIG_NETDB_DNSCLIENT=y
CONFIG_SCHED_LPWORK=y
CONFIG_SCHED_HPWORK=y
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_STM32_RNG=y
CONFIG_STM32_PROGMEM=y
CONFIG_DEV_RANDOM=y
CONFIG_MTD=y
CONFIG_MTD_BYTE_WRITE=y
CONFIG_MTD_CONFIG_NVS=y
CONFIG_MTD_CONFIG_NAMED=y
CONFIG_MTD_CONFIG_NAME_LEN=128
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_LIBM=y
CONFIG_NO_SERIAL_CONSOLE=y
CONFIG_USART3_SERIAL_CONSOLE=n
CONFIG_USART3_BAUD=460800
CONFIG_USART3_RXBUFSIZE=4096
CONFIG_USART3_TXBUFSIZE=2048
CONFIG_SERIAL_TERMIOS=y
CONFIG_NETUTILS_DHCPC=n
CONFIG_RAW_BINARY=y
CONFIG_DEBUG_FULLOPT=y
CONFIG_NETDEV_LATEINIT=y
CONFIG_BOARDCTL_RESET=n
CONFIG_STM32_ADC1=y
CONFIG_ANALOG=y
CONFIG_ADC=y
CONFIG_STM32_ADC_NO_STARTUP_CONV=y
CONFIG_STM32_ADC1_ANIOC_TRIGGER=1
