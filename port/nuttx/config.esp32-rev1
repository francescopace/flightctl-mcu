# Opt-in lab profile for classic ESP32 ECO1 boards with internal SRAM.
CONFIG_ESP32_IGNORE_CHIP_REVISION_CHECK=y
# CONFIG_ESP32_SPIRAM is not set
CONFIG_ESPRESSIF_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESPRESSIF_WIFI_RX_BA_WIN=4
CONFIG_ESPRESSIF_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESPRESSIF_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESPRESSIF_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_IOB_NBUFFERS=64
CONFIG_IOB_THROTTLE=8
CONFIG_NET_TCP_PREALLOC_CONNS=4
# Keep the application and flash access on the PRO CPU on ECO1.
# CONFIG_SMP is not set
CONFIG_SCHED_BACKTRACE=y
# Release the NTP task stack after synchronization.
# CONFIG_NETUTILS_NTPCLIENT_STAY_ON is not set
