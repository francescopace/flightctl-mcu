@@ -125,6 +125,37 @@
  *
  ****************************************************************************/
 
+/* Serialize the reset and restoration with the allocator's peak updates.
+ * Keep the lifetime peak when the single interval observer gives it back. */
+long fc_nuttx_watch_heap(int start)
+{
+  static size_t saved;
+  static bool watching;
+  FAR struct mm_heap_s *heap = USR_HEAP;
+  long result = -1;
+  if (mm_lock(heap) < 0)
+    {
+      return -1;
+    }
+
+  if (start && !watching)
+    {
+      saved = heap->mm_maxused;
+      heap->mm_maxused = heap->mm_curused;
+      watching = true;
+      result = 0;
+    }
+  else if (!start && watching)
+    {
+      result = heap->mm_heapsize - heap->mm_maxused;
+      heap->mm_maxused = saved > heap->mm_maxused ? saved : heap->mm_maxused;
+      watching = false;
+    }
+
+  mm_unlock(heap);
+  return result;
+}
+
 struct mallinfo mm_mallinfo(FAR struct mm_heap_s *heap)
 {
   struct mallinfo info;
