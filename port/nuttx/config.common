CONFIG_DEV_URANDOM=y
CONFIG_DEV_URANDOM_ARCH=y
CONFIG_BOARDCTL_RESET=y
CONFIG_LIBC_FLOATINGPOINT=y
CONFIG_LIBC_LONG_LONG=y
CONFIG_NETUTILS_NTPCLIENT=y
CONFIG_NETUTILS_DHCPC=y
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_TCP_KEEPALIVE=y
CONFIG_NAME_MAX=128
CONFIG_NFILE_DESCRIPTORS_PER_BLOCK=24
CONFIG_USEC_PER_TICK=1000
CONFIG_RR_INTERVAL=20
# CONFIG_NETUTILS_IPERF is not set
# CONFIG_NETUTILS_CJSON is not set
CONFIG_FLIGHTCTL=y
CONFIG_FS_NAMED_SEMAPHORES=y
CONFIG_NETUTILS_NTPCLIENT_NUM_SAMPLES=1
CONFIG_NETUTILS_NTPCLIENT_SERVER="pool.ntp.org"
CONFIG_NET_PREALLOC_DEVIF_CALLBACKS=32
CONFIG_NET_ALLOC_DEVIF_CALLBACKS=4
CONFIG_NET_TCP_ALLOC_CONNS=2
CONFIG_NET_TCP_NWRBCHAINS=16
CONFIG_NETUTILS_NTPCLIENT_STACKSIZE=8192
CONFIG_STACK_COLORATION=y
CONFIG_SCHED_CPULOAD_SYSCLK=y
