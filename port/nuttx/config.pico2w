CONFIG_INIT_ENTRYPOINT="flightctl_main"
CONFIG_INIT_STACKSIZE=18432
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_RP23XX_RNG=y
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_LIBM=y
CONFIG_MTD=y
CONFIG_RP23XX_FLASH_MTD=y
CONFIG_MTD_PARTITION=y
CONFIG_RP23XX_FLASH_MTD_OFFSET=0x18f000
CONFIG_RP23XX_FLASH_MTD_SIZE=0x271000
CONFIG_FS_LITTLEFS=y
CONFIG_NET_SOCKOPTS=y
CONFIG_RAW_BINARY=y
CONFIG_NSH_NETINIT=n
CONFIG_NETUTILS_TELNETD=n
CONFIG_SYSTEM_TELNET_CLIENT=n
CONFIG_TESTING_OSTEST=n
CONFIG_TESTING_GETPRIME=n
CONFIG_EXAMPLES_HELLO=n
CONFIG_DISABLE_POSIX_TIMERS=n
CONFIG_RP23XX_UF2_BINARY=n
CONFIG_ADC=n
CONFIG_RP23XX_ADC=n
CONFIG_RP23XX_ADC_TEMPERATURE=n
CONFIG_ANALOG=n
CONFIG_FS_LITTLEFS_PROGRAM_SIZE_FACTOR=1
CONFIG_FS_LITTLEFS_CACHE_SIZE_FACTOR=1
CONFIG_FS_LITTLEFS_READ_SIZE_FACTOR=1
CONFIG_NET_ETH_PKTSIZE=1514
CONFIG_NET_RECV_BUFSIZE=4380
CONFIG_IOB_THROTTLE=8
