--- a/sched/sched/sched_cpuload.c
+++ b/sched/sched/sched_cpuload.c
@@ -86,6 +86,18 @@
 
 volatile clock_t g_cpuload_total;
 
+/* The utilization window below decays. Telemetry needs monotonic counts. */
+static uint64_t g_sample_total;
+static uint64_t g_sample_busy;
+
+void fc_nuttx_cpu_ticks(uint64_t *total, uint64_t *busy)
+{
+  irqstate_t flags = enter_critical_section();
+  *total = g_sample_total;
+  *busy = g_sample_busy;
+  leave_critical_section(flags);
+}
+
 /****************************************************************************
  * Private Data
  ****************************************************************************/
@@ -151,6 +163,12 @@
 #else
   static clock_t threshold = CPULOAD_TIMECONSTANT;
 #endif
+
+  g_sample_total += ticks;
+  if (!is_idle_task(tcb))
+    {
+      g_sample_busy += ticks;
+    }
 
   tcb->ticks += ticks;
   g_cpuload_total += ticks;
