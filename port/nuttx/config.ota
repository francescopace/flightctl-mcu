CONFIG_ESP32S3_APP_FORMAT_MCUBOOT=y
CONFIG_BOOT_MCUBOOT=y
CONFIG_MTD_BYTE_WRITE=y
CONFIG_ESP32S3_OTA_PRIMARY_SLOT_OFFSET=0x20000
CONFIG_ESP32S3_OTA_SLOT_SIZE=0x200000
CONFIG_ESP32S3_OTA_SECONDARY_SLOT_OFFSET=0x400000
CONFIG_ESP32S3_OTA_SCRATCH_OFFSET=0x600000
CONFIG_ESP32S3_OTA_SCRATCH_SIZE=0x20000
