# ESP32-S3-DevKitC-1 v1.0 (v1.1: 38).
CONFIG_FC_LED_GPIO=48

# The chip's highest clock (ESP-IDF's default is 160 MHz).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_16KB=y

# PSRAM. The S3 comes with none, 2 MB of quad PSRAM (N4R2, N8R2) or 8 MB of
# octal (N8R8, N16R8), and the mode is set at build time: this image takes
# quad PSRAM where there is some and boots without it elsewhere, an octal
# one included; the r8 variant (sdkconfig.r8) takes octal PSRAM. Only
# allocations that ask for it go there (heap_caps_malloc with
# MALLOC_CAP_SPIRAM, or MALLOC_CAP_8BIT once internal RAM has no block
# large enough): an app's linear memory too large for internal RAM, as
# wasm-coremark's 128 KB. malloc() stays internal, the agent's TLS buffers
# with it (in PSRAM they got corrupted on the S2).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# The main task runs the spec loop (TLS, JSON, an app's install, a firmware
# download): 8.9 KB at most of 24 on the classic ESP32 installing an app,
# 6.2 KB on the S3 with v3.14-rc7. Xtensa's frames are larger than RISC-V's:
# 16 KB gives the heap 8 KB back (docs/APPS.md, Size and limits).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
