CONFIG_FC_LED_GPIO=27

# The C5 has the smallest heap margin of the family. With the two kept
# connections (spec long-poll and status) a TLS handshake needs a contiguous
# 16.7 KB block, which was not always there (found in the emulator). Trade
# WiFi throughput for heap: WiFi code in flash, fewer buffers, smaller
# block-ack window.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=4

# The main task runs the spec loop (TLS, JSON, an app's install, a firmware
# download): it used 5.2 KB at most of 24 on the C3, C5 and C6 with
# v3.14-rc7, about twice that is expected for a firmware delta. 14 KB gives
# the heap 10 KB back (docs/APPS.md, Size and limits).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=14336
