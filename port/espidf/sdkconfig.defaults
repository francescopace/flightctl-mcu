CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The agent (TLS handshakes, JSON) runs in the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576

# Flight Control requires TLS 1.3 with ECDSA P-256.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_EPHEMERAL=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# The device writes its certificate request (ESP-IDF 6 leaves X.509 writing
# out unless asked); it writes no certificates.
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CSR_WRITE_C=y
# CONFIG_MBEDTLS_X509_CRT_WRITE_C is not set
# The agent trusts only the CA it is provisioned with, never ESP-IDF's
# bundle of public root CAs (the linker already left it out: no size change).
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE is not set

# Console on USB-Serial/JTAG (native USB port of the devkit).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# WASM apps: WAMR fast interpreter only (no AOT/JIT, no WASI or libc, no
# wasm threads) to keep RAM low on C3/C5.
CONFIG_WAMR_ENABLE_INTERP=y
CONFIG_WAMR_INTERP_FAST=y
# CONFIG_WAMR_ENABLE_AOT is not set
# CONFIG_WAMR_ENABLE_LIBC_WASI is not set
# CONFIG_WAMR_ENABLE_LIBC_BUILTIN is not set
# CONFIG_WAMR_ENABLE_LIB_PTHREAD is not set

# Field provisioning (port/espidf/main/main.c) runs protocomm's security 1:
# X25519 and the proof of possession. ESP-IDF 6 builds it only on request.
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
