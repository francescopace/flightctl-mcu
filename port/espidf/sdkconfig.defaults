CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The agent (TLS handshakes, JSON) runs in the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576

# CPU use for status.resources: the idle tasks' run time, in esp_timer
# microseconds, on 64 bits (32 would wrap after 71 minutes).
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y

# Flight Control requires TLS 1.3 with ECDSA P-256.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_EPHEMERAL=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
# Dynamic TLS buffers, sized to each record and freed once it is read: a
# connection that waits holds little. A full-size record (16 KB) takes the
# block the agent reserves at its start (core/include/fc_tls_pool.h, through
# mbedtls_platform_set_calloc_free), so it never depends on finding 16.7 KB
# in one piece. With fixed buffers each new connection kept its buffers for
# as long as it lived, in the middle of the heap: on an ESP32-C5 and a
# classic ESP32, CoreMark's 64 KB no longer fitted after an app restart
# (52 KB in one piece out of about 100 KB free); with dynamic ones all
# but about one try in seven passed (RESULTS.md).
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# The device writes its certificate request (ESP-IDF 6 leaves X.509 writing
# out unless asked); it writes no certificates.
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CSR_WRITE_C=y
# CONFIG_MBEDTLS_X509_CRT_WRITE_C is not set
# The agent trusts only the CA it is provisioned with, never ESP-IDF's
# bundle of public root CAs (the linker already left it out: no size change).
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE is not set

# Optimization, as in the Zephyr build: the firmware for size (-Os), WAMR,
# which runs the apps, for speed (-O2, CMakeLists.txt), assertions kept but
# without their messages. The agent waits on the network; RAM and the OTA
# slots are what is short. The CPU runs at the chip's highest clock: set per
# chip where it is not ESP-IDF's default (sdkconfig.defaults.<chip>).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# Console on USB-Serial/JTAG (native USB port of the devkit).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# WASM apps: WAMR fast interpreter only (no AOT/JIT, no WASI, no wasm
# threads) to keep RAM low on C3/C5. libc-builtin: a few C library functions
# for the apps (core/src/fc_apps.c, s_libc), in flash.
CONFIG_WAMR_ENABLE_INTERP=y
CONFIG_WAMR_INTERP_FAST=y
# CONFIG_WAMR_ENABLE_AOT is not set
# CONFIG_WAMR_ENABLE_LIBC_WASI is not set
CONFIG_WAMR_ENABLE_LIBC_BUILTIN=y
# CONFIG_WAMR_ENABLE_LIB_PTHREAD is not set

