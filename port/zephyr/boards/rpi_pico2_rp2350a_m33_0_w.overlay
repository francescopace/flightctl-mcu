/* Standalone firmware in the first 3 MiB of the Pico 2 W's 4 MiB flash. */
#ifndef FC_PICO2_OTA_SLOTS
&code_partition {
	reg = <0x0 0x00300000>;
};
#endif

/* WL_GPIO0 lives on the Wi-Fi chip. The upstream MCUboot board DTS
 * omits its GPIO child; the standalone board already declares it. */
&pio0_spi0 {
	airoc-wifi@0 {
		cyw43_gpio: gpio {
			compatible = "infineon,cyw43-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <3>;
		};
	};
};

&pinctrl {
	app_uart1: app_uart1 {
		group1 { pinmux = <UART1_TX_P8>; };
		group2 { pinmux = <UART1_RX_P9>; input-enable; };
	};
	app_pwm: app_pwm {
		group1 { pinmux = <PWM_7A_P14>; };
	};
};

/* The wireless board reserves GP25 and GP29 for its PIO Wi-Fi bus. */
&adc_default {
	group1 { pinmux = <ADC_CH0_P26>; };
};
&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};
&pwm {
	pinctrl-0 = <&app_pwm>;
	status = "okay";
};
&spi0_default {
	group1 { pinmux = <SPI0_SCK_P18>, <SPI0_TX_P19>; };
};
&spi0 { status = "okay"; };
&i2c1 { status = "disabled"; };
&uart1 {
	pinctrl-0 = <&app_uart1>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&flash0 {
	partitions {
		fc_creds_partition: partition@300000 {
			compatible = "zephyr,mapped-partition";
			label = "fc_creds";
			reg = <0x00300000 0x00004000>;
		};
		fc_storage_partition: partition@304000 {
			compatible = "zephyr,mapped-partition";
			label = "fc_storage";
			reg = <0x00304000 0x000fc000>;
		};
	};
};

/ {
	aliases { led0 = &app_led; };
	leds {
		compatible = "gpio-leds";
		app_led: led-0 { gpios = <&cyw43_gpio 0 GPIO_ACTIVE_HIGH>; };
	};
	fc-hw {
		compatible = "flightctl,app-hw";
		gpio6 { gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>; };
		adc0 { io-channels = <&adc 0>; };
		pwm0 { pwms = <&pwm 14 PWM_MSEC(1) PWM_POLARITY_NORMAL>; };
		i2c0 { i2c-bus = <&i2c0>; clock-frequency = <100000>; };
		spi0 { spi-bus = <&spi0>; cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>; };
		uart1 { uart = <&uart1>; current-speed = <115200>; };
		core-temperature {
			temperature-sensor = <&die_temp>;
			die-temperature;
		};
	};
};
