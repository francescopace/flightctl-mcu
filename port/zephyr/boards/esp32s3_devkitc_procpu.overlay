/*
 * ESP32-S3-DevKitC (8 MB of flash), started by MCUboot: Zephyr's layout for
 * this board (MCUboot in the first 64 KB, two slots of 2880 KB), with its
 * storage partition, 192 KB, split into the credentials and the agent's
 * storage as on the other boards.
 */

#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/delete-node/ &storage_partition;
/delete-node/ &coredump_partition;

&flash0 {
	partitions {
		coredump_partition: partition@7e0000 {
			compatible = "zephyr,mapped-partition";
			label = "coredump";
			reg = <0x007e0000 0x00020000>;
		};
		fc_creds_partition: partition@7b0000 {
			compatible = "zephyr,mapped-partition";
			label = "fc_creds";
			reg = <0x007b0000 0x00004000>;
		};

		fc_storage_partition: partition@7b4000 {
			compatible = "zephyr,mapped-partition";
			label = "fc_storage";
			reg = <0x007b4000 0x0002c000>;
		};
	};
};

&wifi {
	status = "okay";
};

/* The chip's random generator: Zephyr's entropy device, and PSA's source. */
&trng0 {
	status = "okay";
};

/* The N8R8 module's PSRAM: 8 MB, octal (the .conf). */
&psram0 {
	size = <DT_SIZE_M(8)>;
};

&coretemp {
	status = "okay";
};

&pinctrl {
	app_pwm: app_pwm {
		group1 { pinmux = <LEDC_CH0_GPIO7>; output-enable; };
	};
	app_rgb: app_rgb {
		group1 { pinmux = <SPIM3_MOSI_GPIO48>; output-low; };
	};
};

/* SPI3 supplies the WS2812 waveform on MOSI alone. Apps use SPI2. */
&spi3 {
	pinctrl-0 = <&app_rgb>;
	line-idle-low;
	status = "okay";
	app_pixel: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;
		spi-max-frequency = <6400000>;
		spi-cpha;
		spi-one-frame = <0xf0>;
		spi-zero-frame = <0xc0>;
		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
		reset-delay = <300>;
	};
};

&ledc0 {
	pinctrl-0 = <&app_pwm>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	channel@0 { reg = <0>; timer = <0>; };
};

&adc0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	channel@3 {
		reg = <3>; /* ADC1 channel 3 is GPIO4. */
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&i2c0 { status = "okay"; };
/* fc_hw holds CS across transfers when requested by the app. */
&spim2_default {
	group1 { pinmux = <SPIM2_MISO_GPIO13>, <SPIM2_SCLK_GPIO12>; };
};
&uart1 {
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
	status = "okay";
};

/ {
	aliases { led-strip = &app_pixel; };
	fc-hw {
		compatible = "flightctl,app-hw";
		gpio6 { gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>; };
		adc0 { io-channels = <&adc0 3>; };
		pwm0 { pwms = <&ledc0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>; };
		i2c0 { i2c-bus = <&i2c0>; clock-frequency = <100000>; };
		spi0 { spi-bus = <&spi2>; cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>; };
		uart1 { uart = <&uart1>; current-speed = <115200>; };
		core-temperature {
			temperature-sensor = <&coretemp>;
			die-temperature;
		};
	};
};
