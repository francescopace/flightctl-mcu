# flightctl-mcu application options.

config FC_PHYSICAL_APP_HW
	bool
	default y if BOARD_NUCLEO_F767ZI
	default y if BOARD_ESP32_DEVKITC || BOARD_ESP32C3_DEVKITM || BOARD_ESP32C5_DEVKITC || BOARD_ESP32C6_DEVKITC
	default y if BOARD_NRF7002DK_NRF5340_CPUAPP || BOARD_ESP32S3_DEVKITC_ESP32S3_PROCPU
	default y if BOARD_RPI_PICO2_RP2350A_M33_0_W || BOARD_RPI_PICO2_RP2350A_M33_0_W_MCUBOOT
	help
	  Use the board's physical LED and devicetree sensors for WASM apps.
	  Omit the console LED and uptime-based temperature fallback.

config FC_STORAGE_SETTINGS
	bool
	default y if BOARD_NUCLEO_F767ZI

config FC_SNTP_SERVER
	string "SNTP server the device takes the time from"
	default "pool.ntp.org"

config FC_LIBC_HEAP_WATERMARK
	bool "Track minimum free space in the common libc malloc arena"
	depends on COMMON_LIBC_MALLOC && SYS_HEAP_RUNTIME_STATS && COMMON_LIBC_MALLOC_ARENA_SIZE != 0

config FC_HEAP_SIZE
	int "Size of the C heap (malloc), in bytes"
	default 163840
	help
	  Everything the agent allocates: TLS sessions, JSON documents, WASM
	  modules and their memory. The device reports how much of it is free.

config FC_ESP_INTERNAL_HEAPS
	bool "Use additional internal SRAM for the agent heap"
	depends on (SOC_ESP32_PROCPU && ESP32_REGION_1_NOINIT) || SOC_ESP32C5_HPCORE
	depends on BOOTLOADER_MCUBOOT && !SMP && !SOC_ENABLE_APPCPU && !ESP_SPIRAM && !BT
	depends on !COMMON_LIBC_MALLOC && !CRYPTO && !ESP32_ULP_COPROC_ENABLED
	select MULTI_HEAP
	help
	  After kernel startup, use the RAM vacated by MCUboot and the ROM
	  startup stack. On ESP32-C5, try the extra high-performance SRAM bank
	  before the main heap and use RTC RAM as a last resort. On the classic
	  ESP32, try the smaller banks first to leave room for WASM linear memory.

config FC_APP_HEAP_CHECK
	bool "Refuse an app whose memory leaves the agent too little of the C heap"
	depends on !COMMON_LIBC_MALLOC
	help
	  The floor of heap for the agent (docs/APPS.md, Size and limits): an
	  app whose instance leaves less than 40 KB of the C heap is refused,
	  and the largest .wasm follows what is free. With it the device also
	  logs, and puts in customInfo heapAgentBytes, what the agent took of
	  the heap after an app's instance. Off until the floor is measured
	  on a board with Zephyr: there TLS's receive buffers are reserved
	  apart, and the agent's needs differ from ESP-IDF's.

config FC_AGENT_STACK_SIZE
	int "Stack of the agent's status thread, in bytes (0: the core's default)"
	default 0
	help
	  The core asks for 12 KB on a microcontroller. The agent's other loop,
	  the spec's, runs on the main thread (CONFIG_MAIN_STACK_SIZE). A board
	  short of RAM can give less once it has measured what the threads use
	  (customInfo stackMinFreeBytes).

config FC_CONSOLE_CRASH
	bool "Test only: a console command, crash, that makes the device fault"
	help
	  For the test of what the device's log keeps across a crash. Never
	  in a release.

config FC_FW_VERSION
	string "Firmware version, logged at boot"
	default "dev"

config FC_METRICS_INTERVAL
	int "Counters in customInfo read every (s)"
	default 3600
	help
	  The heap's low-water mark, traffic. The statuses in between repeat
	  the last values: Flight Control 1.4 logs an event for every change
	  in the status.

config FC_OTA_VERIFY_TIMEOUT
	int "Seconds a new firmware has to reach Flight Control before it is given up"
	default 150
	help
	  Counted from the boot into the new image. After it the device
	  restarts and MCUboot puts the previous image back.

config FC_TEST_SERVER_PORT
	int "Test only: force this agent endpoint port (0: off)"
	default 0
	help
	  For the test of the way back: a firmware that cannot reach Flight
	  Control whatever the device was provisioned with.

config FC_FW_PLATFORM
	string "The name of this board's firmware in a release"
	default BOARD
	help
	  A firmware release is an OCI index with an image per platform; the
	  device takes the one whose platform.architecture is this.

config FC_LOG_DEBUG
	bool "Log the agent's debug messages"
	default n

source "Kconfig.zephyr"
