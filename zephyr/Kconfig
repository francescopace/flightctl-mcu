# flightctl-mcu application options.

config FC_SNTP_SERVER
	string "SNTP server the device takes the time from"
	default "pool.ntp.org"

config FC_HEAP_SIZE
	int "Size of the C heap (malloc), in bytes"
	default 163840
	help
	  Everything the agent allocates: TLS sessions, JSON documents, WASM
	  modules and their memory. The device reports how much of it is free.

config FC_AGENT_STACK_SIZE
	int "Stack of each of the agent's two threads, in bytes (0: the core's default)"
	default 0
	help
	  The core asks for 24 KB on a microcontroller. A board short of RAM can
	  give less once it has measured what the threads use (CONFIG_INIT_STACKS
	  and, on the Pico, the console's stack report).

config FC_ENTROPY_RP2_ROSC
	bool "Entropy from the RP2040's ring oscillator"
	depends on SOC_SERIES_RP2040
	depends on DT_HAS_FLIGHTCTL_RP2040_ROSC_RNG_ENABLED
	default y
	select ENTROPY_HAS_DRIVER
	select ENTROPY_NEEDS_PRNG
	help
	  The RP2040 has no random generator and Zephyr no entropy driver for
	  it. This is one (port/zephyr/fc_entropy_rp2.c), for the node the
	  board overlay adds and chooses as zephyr,entropy: the chip's ring
	  oscillator, from which Zephyr and PSA seed their generators.

config FC_FW_VERSION
	string "Firmware version, logged at boot"
	default "dev"

config FC_OTA_VERIFY_TIMEOUT
	int "Seconds a new firmware has to reach Flight Control before it is given up"
	default 150
	help
	  Counted from the boot into the new image. After it the device
	  restarts and MCUboot puts the previous image back.

config FC_TEST_SERVER_PORT
	int "Test only: force this agent endpoint port (0: off)"
	default 0
	help
	  For the test of the way back: a firmware that cannot reach Flight
	  Control whatever the device was provisioned with.

config FC_FW_PLATFORM
	string "The name of this board's firmware in a release"
	default BOARD
	help
	  A firmware release is an OCI index with an image per platform; the
	  device takes the one whose platform.architecture is this.

config FC_LOG_DEBUG
	bool "Log the agent's debug messages"
	default n

source "Kconfig.zephyr"
