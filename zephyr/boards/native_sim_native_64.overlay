/*
 * native_sim's 2 MB of simulated flash: Zephyr's own partitions fill the
 * first MB; ours go in the second.
 */
&flash0 {
	partitions {
		fc_creds_partition: partition@100000 {
			compatible = "zephyr,mapped-partition";
			label = "fc_creds";
			reg = <0x00100000 0x00004000>;
		};
		fc_storage_partition: partition@104000 {
			compatible = "zephyr,mapped-partition";
			label = "fc_storage";
			reg = <0x00104000 0x000fc000>;
		};
	};
};
