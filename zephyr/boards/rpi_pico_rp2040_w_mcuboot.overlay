/*
 * The Pico W with MCUboot: Zephyr's layout for this board (MCUboot in the
 * first 64 KB, two slots of 832 KB), with its storage partition, the last
 * 320 KB, split into the credentials and the agent's storage as in the build
 * without MCUboot.
 */
/delete-node/ &storage_partition;

&flash0 {
	partitions {
		fc_creds_partition: partition@1b0000 {
			compatible = "zephyr,mapped-partition";
			label = "fc_creds";
			reg = <0x001b0000 0x00004000>;
		};
		fc_storage_partition: partition@1b4000 {
			compatible = "zephyr,mapped-partition";
			label = "fc_storage";
			reg = <0x001b4000 0x0004c000>;
		};
	};
};

/ {
	chosen {
		zephyr,entropy = &fc_rosc_rng;
	};

	/* The ring oscillator as the entropy device (port/zephyr/fc_entropy_rp2.c). */
	fc_rosc_rng: fc-rosc-rng {
		compatible = "flightctl,rp2040-rosc-rng";
		status = "okay";
	};
};
