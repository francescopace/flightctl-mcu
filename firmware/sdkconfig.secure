# Secure variant, for devices in the field: Secure Boot v2, flash encryption
# in release mode and NVS encryption.
#   VARIANT=secure SECURE_BOOT_KEY=<rsa3072.pem> firmware/build.sh
# The first boot of such an image burns eFuses for good: the hash of the
# Secure Boot key, a flash encryption key generated on the chip, and the bits
# that turn both on. Afterwards the chip runs only images signed with that
# key, and the flash can no longer be read in clear. See docs/SECURITY.md.
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="/keys/secure_boot_signing_key.pem"
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
# The ROM download mode stays, in its secure form: it writes flash (to
# provision fc_creds again) but cannot read it or run code.
CONFIG_SECURE_ENABLE_SECURE_ROM_DL_MODE=y
# NVS keys in the nvs_keys partition, protected by flash encryption: the same
# scheme on every chip, including the ESP32, which has no HMAC peripheral.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC=y
# Secure Boot v2 on the classic ESP32 needs silicon revision 3.
CONFIG_ESP32_REV_MIN_3=y
